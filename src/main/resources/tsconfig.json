{
  "compilerOptions": {
    "target": "ES2025",
    "module": "CommonJS",
    "lib": ["ES2025"],
    "outDir": "../../../build/resources/main",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "/lib/xp/*": ["../../../node_modules/@enonic-types/lib-*"],
      "/lib/mustache": ["./types/mustache"],
      "/lib/http-client": ["./types/http-client"]
    },
    "types": ["@enonic-types/global", "@enonic-types/lib-http-client"]
  },
  "include": ["**/*.ts"],
  "exclude": ["assets/**"]
}
